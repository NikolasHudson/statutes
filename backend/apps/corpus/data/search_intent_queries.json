{
  "_": [
    "Table-driven fixtures for the search-box intent classifier",
    "(apps/corpus/services/search_intent.py). Each row: the query as an",
    "attorney would type it, the expected auto-detected mode, and (optional)",
    "expected operator tokens / phrases / unsupported connector tokens /",
    "compiled tsquery + function. test_search_intent.py asserts every row;",
    "extend this file as real SearchLog data surfaces new patterns."
  ],
  "queries": [
    {"q": "714.16", "mode": "citation"},
    {"q": "§ 714.16", "mode": "citation"},
    {"q": "Chapter 714H", "mode": "citation"},
    {"q": "32:1.10", "mode": "citation"},
    {"q": "998 N.W.2d 646", "mode": "citation"},
    {"q": "223 n.w.2d 270", "mode": "citation"},

    {"q": "elements of adverse possession against a cotenant", "mode": "natural"},
    {"q": "what happens when a landlord withholds a deposit", "mode": "natural"},
    {"q": "slayer rule and life insurance", "mode": "natural",
     "note": "lowercase 'and' is prose, not a connector"},
    {"q": "SLAYER RULE AND LIFE INSURANCE", "mode": "natural",
     "note": "all-caps query = shouting, not connectors"},
    {"q": "AT&T tariff dispute", "mode": "natural",
     "note": "unspaced ampersand never triggers"},
    {"q": "cases about \"constructive eviction\" by a landlord", "mode": "natural",
     "phrases": ["constructive eviction"],
     "note": "embedded phrase = hard filter inside natural mode"},
    {"q": "State v. Williams confrontation clause", "mode": "natural"},
    {"q": "damages under 714.16 for consumer fraud", "mode": "natural",
     "note": "embedded cite does not flip the whole query to citation mode"},

    {"q": "landlord AND deposit", "mode": "boolean", "operators": ["AND"],
     "tsquery": "landlord deposit", "tsquery_func": "websearch_to_tsquery"},
    {"q": "waiver OR estoppel", "mode": "boolean", "operators": ["OR"],
     "tsquery": "waiver or estoppel", "tsquery_func": "websearch_to_tsquery"},
    {"q": "mechanic's lien NOT residential", "mode": "boolean", "operators": ["NOT"],
     "tsquery": "mechanic's lien -residential", "tsquery_func": "websearch_to_tsquery"},
    {"q": "\"implied warranty of habitability\"", "mode": "boolean",
     "phrases": ["implied warranty of habitability"],
     "operators": ["exact-phrase"],
     "tsquery": "\"implied warranty of habitability\"",
     "tsquery_func": "websearch_to_tsquery",
     "note": "entirely-quoted query = exact phrase with honest count"},
    {"q": "dog & bite", "mode": "boolean", "operators": ["&"],
     "tsquery": "dog & bite", "tsquery_func": "to_tsquery"},
    {"q": "negligen! AND supervision", "mode": "boolean",
     "operators": ["AND", "negligen!"],
     "tsquery": "negligen:* & supervision", "tsquery_func": "to_tsquery"},
    {"q": "(waiver OR estoppel) AND \"mechanic's lien\"", "mode": "boolean",
     "phrases": ["mechanic's lien"],
     "tsquery": "( waiver | estoppel ) & (mechanics<->lien)",
     "tsquery_func": "to_tsquery"},
    {"q": "landlord /p \"constructive eviction\"", "mode": "boolean",
     "operators": ["/p"], "unsupported": ["/p"],
     "tsquery": "landlord & (constructive<->eviction)", "tsquery_func": "to_tsquery"},
    {"q": "dog w/5 bite", "mode": "boolean", "operators": ["w/5"], "unsupported": ["w/5"],
     "tsquery": "dog & bite", "tsquery_func": "to_tsquery"},
    {"q": "attorney /s disqualif!", "mode": "boolean",
     "operators": ["/s", "disqualif!"], "unsupported": ["/s"],
     "tsquery": "attorney & disqualif:*", "tsquery_func": "to_tsquery"},
    {"q": "fraud AND (concealment OR misrepresentation) NOT securities",
     "mode": "boolean",
     "tsquery": "fraud & ( concealment | misrepresentation ) & ! securities",
     "tsquery_func": "to_tsquery"},

    {"q": "trade secret", "mode": "natural"},
    {"q": "quiet title action boundary by acquiescence", "mode": "natural"},
    {"q": "eminent domain \"public use\" farmland", "mode": "natural",
     "phrases": ["public use"]}
  ]
}
