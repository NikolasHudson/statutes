# Marketing site environment.
#
# SCOPE MATTERS. Anything named NEXT_PUBLIC_* is INLINED INTO THE BUNDLE AT
# BUILD TIME — it cannot be supplied, changed, or corrected at runtime. In the
# App Platform spec those must be scope: BUILD_TIME (or RUN_AND_BUILD_TIME), and
# they must be LITERALS: a bindable variable (${APP_URL}, ${APP_DOMAIN}, ${db.*})
# is runtime-only for a Dockerfile build — it passes `doctl apps spec validate`
# and arrives at the build EMPTY.
#
# Every var below is also declared as an `ARG` in the Dockerfile. It has to be:
# App Platform passes build-time envs as --build-arg, and a Dockerfile with no
# matching ARG discards them silently, with a green build.

# --- BUILD TIME (baked in; a wrong value has no runtime fix) -----------------

# This site's own canonical origin: sitemap.xml, robots.txt, every canonical and
# OG tag, and the domain printed on the OG card image.
# IF UNSET: the production build FAILS (lib/site.ts). It used to default to
# localhost, which would have shipped a sitemap and OG tags advertising
# http://localhost:3001 to every crawler on day one.
NEXT_PUBLIC_SITE_URL=https://hudsonlegal.tech

# The app's origin. Every "Get started" / "Open Hudson Corpus" CTA, the footer's
# Terms and Privacy links, the MCP endpoint URL, and the copy-pasteable MCP
# client config on /products/mcp are built from this — 71 hrefs across 10 pages.
# IF UNSET: the production build FAILS (lib/site.ts).
NEXT_PUBLIC_APP_URL=https://app.hudsonlegal.tech

# The address the email assistant answers from, printed verbatim on
# /products/email as the address to write to.
# IF UNSET: the production build FAILS (lib/site.ts) — a stale value here sends
# visitors' mail to a dead mailbox, and nothing would ever alert us to it.
NEXT_PUBLIC_ASSISTANT_ADDRESS=assistant@mail.hudsonlegal.tech

# Set to 1 only once Stripe is live. Until then /pricing keeps its pre-launch
# framing (prices announced, billing not started) instead of linking the CTAs
# straight into the app's self-serve checkout.
# IF UNSET: pre-launch framing. Safe default — leave empty until billing is on.
NEXT_PUBLIC_BILLING_LIVE=

# Where "Prefer email?" points on /contact and /consulting. OPTIONAL — and the
# only NEXT_PUBLIC_* here with NO build-time guard: it falls back to a default
# instead of failing the build. That makes it the easiest one to get silently
# wrong, so it is declared as an `ARG` in the Dockerfile like all the others. It
# was not, until now: setting it in the app spec produced a green build that
# shipped the default anyway.
# IF UNSET: defaults to consulting@hudsonlegal.tech (lib/site.ts) — which does
# NOT receive mail today: the domain has no MX record. Set this once a real
# mailbox exists, or accept that the address is decorative.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- RUN AND BUILD TIME ------------------------------------------------------

# Backend origin for server-side calls. Read at BUILD (the home/products corpus
# counts, the article pages and the sitemap are all prerendered against it) and
# again at RUNTIME (ISR revalidation, plus the /api/contact and /api/subscribe
# proxies, which relay browser posts server-side — which is precisely why the
# marketing origin needs no entry in the backend's CORS list).
# IF UNSET: falls back to NEXT_PUBLIC_APP_URL (in prod the backend shares the app
# origin, serving /api/*). If it is set but EMPTY, lib/api.ts still falls back —
# `||`, not `??`, because an unpassed Docker build-arg arrives as "".
# IF UNREACHABLE AT BUILD: the production build FAILS, on purpose — a green build
# would otherwise ship a sitemap with no articles and a corpus count of zero.
API_ORIGIN=http://localhost:8000
