# Where marketing CTAs ("Sign in", "Get started", "Start researching") send
# people — the app's origin. Defaults to the production app if unset.
NEXT_PUBLIC_APP_URL=https://corpus.nick.law

# This marketing site's own canonical/public URL (used for metadata, OG tags,
# sitemaps). Set per environment; the marketing domain is TBD.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Backend origin for server-side calls (articles fetch + contact/newsletter
# relays). Server-only — not NEXT_PUBLIC. Defaults to NEXT_PUBLIC_APP_URL
# (the backend shares the app origin in prod, serving /api/*).
API_ORIGIN=http://localhost:8000

# Set to 1 only once the price points are final and Stripe is live. Until then
# /pricing keeps its beta framing (Pro "coming soon", firms → consult form)
# instead of linking straight to self-serve checkout.
NEXT_PUBLIC_BILLING_LIVE=
