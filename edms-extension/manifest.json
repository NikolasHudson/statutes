{
  "manifest_version": 3,
  "name": "Hudson EDMSpro",
  "version": "0.2.0",
  "description": "Save Iowa court filings straight from the docket into your own cloud storage, named and filed the way you want them.",
  "key": "",
  "permissions": [
    "storage",
    "downloads",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.iowacourts.state.ia.us/*",
    "https://*.iowacourts.gov/*",
    "https://app.hudsonlegal.tech/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hudson EDMSpro",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.iowacourts.state.ia.us/*",
        "https://*.iowacourts.gov/*"
      ],
      "js": [
        "zip.js",
        "content.js"
      ],
      "css": [
        "tokens.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": [
        "https://*.iowacourts.state.ia.us/*",
        "https://*.iowacourts.gov/*"
      ]
    }
  ]
}
